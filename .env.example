PORT=3000
NODE_ENV=development

# ---- Shopify (server-side only, never expose to the browser) ----
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2025-01

# ---- LLM ----
# "provider:model" — e.g. groq:openai/gpt-oss-120b , anthropic:claude-sonnet-5 , openai:gpt-4.1
AI_MODEL=groq:openai/gpt-oss-120b
# Used only when the primary model is rate-limited (cheaper / higher quota)
AI_FALLBACK_MODEL=groq:llama-3.1-8b-instant
AI_API_KEY=

# ---- Search tuning ----
MAX_PRODUCT_RESULTS=5
SHOPIFY_PAGE_SIZE=20
MAX_PAGES_PER_SEARCH=5
VARIANT_PAGE_SIZE=50
# Variants per product sent to the LLM — keep low on token-per-minute plans
MAX_VARIANTS_PER_PRODUCT=6

# ---- Limits ----
MAX_MESSAGE_LENGTH=1000
SHOPIFY_TIMEOUT_MS=15000
AGENT_TIMEOUT_MS=45000

# ---- Dev-only tool tester endpoint (POST /api/tools/:toolName) ----
ENABLE_TOOL_TESTER=true

# ---- Browser origins allowed to call the public /api/v1 API ----
# Comma-separated, or * for any. Empty = same-origin only.
CORS_ORIGINS=
